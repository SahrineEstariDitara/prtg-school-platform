# --- PRTG Server Configuration ---
PRTG_SERVER=http://127.0.0.1:8080
PRTG_USERNAME=ISI_USERNAME_PRTG
# Isi salah satu: PRTG_PASSHASH (disarankan) atau PRTG_PASSWORD
PRTG_PASSHASH=
PRTG_PASSWORD=ISI_PASSWORD_PRTG
PRTG_VERIFY_SSL=false
PRTG_TIMEOUT=30
PRTG_COUNT=50000

# --- Flask Web Dashboard (Existing) ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_SECRET_KEY=ISI_SECRET_KEY_ACAK_MIN_32_KARAKTER
DASHBOARD_USERNAME=ISI_USERNAME_DASHBOARD
DASHBOARD_PASSWORD=ISI_PASSWORD_DASHBOARD
INTERVAL_PENCATAT=60

# --- WhatsApp GreenAPI (Existing Bot) ---
GREENAPI_API_URL=https://7107.api.greenapi.com
GREENAPI_ID_INSTANCE=ISI_ID_INSTANCE
GREENAPI_TOKEN=ISI_TOKEN_GREENAPI
WA_TARGET=ISI_NOMOR_ATAU_GROUP_ID
JADWAL_WA=07:00,11:00,15:00
CHECK_INTERVAL=300

# --- PostgreSQL Operational Database (M3) ---
DATABASE_URL=postgresql+psycopg://postgres:ISI_PASSWORD_DB@localhost:5433/prtg_school_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:ISI_PASSWORD_DB@localhost:5433/prtg_school_test
PRTG_STALE_THRESHOLD_SECONDS=180

# --- Initial Admin Seed (M3) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ISI_PASSWORD_ADMIN_AWAL
ADMIN_SEED_FULL_NAME=Administrator Sistem

# --- JWT Authentication (M4) ---
JWT_SECRET_KEY=ISI_JWT_SECRET_KEY_MIN_32_KARAKTER
JWT_ACCESS_EXPIRES_MINUTES=30
JWT_REFRESH_EXPIRES_DAYS=7

# --- Operational Workflow, Uploads & Push FCM (M5) ---
UPLOAD_DIR=uploads
MAX_ATTACHMENT_BYTES=5242880
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_PATH=
ENABLE_OPERATIONAL_WORKER=false
