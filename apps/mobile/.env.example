# Base URL untuk Shared Backend REST API v1
# Android Emulator -> host Windows localhost:5001
EXPO_PUBLIC_API_URL=http://10.0.2.2:5001/api/v1

# Untuk HP Android fisik via USB:
# 1) Jalankan: adb reverse tcp:5001 tcp:5001
# 2) Ubah menjadi: EXPO_PUBLIC_API_URL=http://localhost:5001/api/v1
# Atau gunakan IP LAN PC Anda: EXPO_PUBLIC_API_URL=http://192.168.x.x:5001/api/v1
